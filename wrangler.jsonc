{
  "name": "sunclub",
  "main": "src/worker.js",
  "compatibility_date": "2026-06-01",
  "assets": { "directory": "./public", "binding": "ASSETS" },
  "durable_objects": { "bindings": [{ "name": "CLUB", "class_name": "Club" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Club"] }]
  // Поддомен (например sunclub.yandarov.com) добавляется после переноса DNS в Cloudflare:
  // "routes": [{ "pattern": "sunclub.yandarov.com", "custom_domain": true }]
}
